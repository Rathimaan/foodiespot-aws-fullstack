{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "FoodieSpotS3BucketAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject",
        "s3:ListBucket"
      ],
      "Resource": [
        "arn:aws:s3:::foodiespot-media-bucket",
        "arn:aws:s3:::foodiespot-media-bucket/*"
      ]
    }
  ]
}
