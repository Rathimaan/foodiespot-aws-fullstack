# Server Configuration
PORT=4000
NODE_ENV=development

# Database Connection (MongoDB Atlas / Local MongoDB)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/foodiespot

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# Stripe Payment Secret (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# AWS Cloud Infrastructure Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_S3_BUCKET_NAME=foodiespot-media-bucket
